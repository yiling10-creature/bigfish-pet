{
  "name": "bigfish-chat-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "大肥鱼桌宠 — standalone Electron desktop pet for dsh-bigfish",
  "main": "main.cjs",
  "author": "Yiling",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:dir": "electron-builder --win --dir",
    "pack:zip": "electron-builder --win zip",
    "dist": "electron-builder --win portable",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "afterPack": "./after-pack.cjs",
    "appId": "studio.bigfish.general-chat",
    "productName": "大肥鱼普通对话版",
    "executableName": "BigFishChat",
    "copyright": "Yiling · dsh-bigfish contributors · Code MIT",
    "asar": true,
    "directories": {
      "output": "../dist",
      "buildResources": "resources"
    },
    "files": [
      "main.cjs",
      "deepseek.cjs",
      "providers.cjs",
      "memory.cjs",
      "web-search.cjs",
      "preload.cjs",
      "resources/pet.html",
      "resources/tray.png",
      "resources/icon.png",
      "resources/LICENSE",
      "resources/NOTICE",
      "resources/third-party-licenses.txt",
      "window-focus.cjs",
      "chat-input.cjs",
      "resources/chat-input.html"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "BigFishPet-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BigFishPet-${version}-${arch}.${ext}"
    },
    "extraFiles": [
      {
        "to": "大肥鱼桌宠.exe",
        "from": "../launcher/out/BigFishPetLauncher.exe"
      }
    ]
  }
}
